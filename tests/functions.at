AT_DATA([function.scm],
[[
(display (evaluator-get-string (evaluator-create "min(x,y)")))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [min(x,y)], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-get-string (evaluator-create "max(1,2)+min(3,-4)")))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [(-2)], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-evaluate (evaluator-create "min(x,y)") 2 (list "x" "y") (list 1 2)))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [1.0], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-evaluate (evaluator-create "max(x,y)") 2 (list "x" "y") (list 1 2)))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [2.0], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-get-string (evaluator-derivative-x (evaluator-create "min(x^2,y)"))))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [select(select(step((y-(x^2))),1,select(step(((x^2)-y)),0,step(abs((x^2))))),(2*x),0)], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-evaluate (evaluator-derivative-x (evaluator-create "min(x^2,y)")) 2 (list "x" "y") (list 2 1)))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [0.0], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-evaluate (evaluator-derivative-x (evaluator-create "max(x^2,y)")) 2 (list "x" "y") (list 2 1)))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [4.0], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-evaluate-x (evaluator-derivative-x (evaluator-create "min(x,2*x-1)")) 1))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [1.0], [ignore])

