]])

AT_CHECK([matheval.sh function.scm], [ignore], [1.0], [ignore])

AT_DATA([function.scm],
[[
(display (evaluator-get-string (evaluator-derivative-x (evaluator-create "max(x,0)"))))
]])

AT_CHECK([matheval.sh function.scm], [ignore], [select(select(step(x),1,select(step((0-x)),0,step(abs(x)))),1,0)], [ignore])

